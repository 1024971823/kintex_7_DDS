{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Digital IDE: Run XSIM + FFT SFDR Verification (Generate VCD)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/run_xsim.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Digital IDE: Regenerate Sine Quarter-Wave ROM",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/gen_sin_lut.py"
            ],
            "problemMatcher": []
        }
    ]
}
